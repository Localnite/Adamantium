# clangd setup for the msvc-wine toolchain used by build-linux.sh (paths are absolute: clangd does not expand ~ or $HOME).
# If msvc-wine moves or the MSVC / Windows SDK versions change, update the paths below.

CompileFlags:
  Compiler: clang-cl
  Add:
    - "--target=x86_64-pc-windows-msvc"
    - "-fms-compatibility"
    - "-fms-extensions"
    - "-fdelayed-template-parsing"
    - "/std:c++latest"
    - "/EHsc"
    - "-ferror-limit=0"
    - "-Wno-pragma-pack"
    - "-Wno-unknown-pragmas"
    - "-Wno-microsoft-include"
    - "-imsvc/home/guestd/msvc-wine/visualstudio-download/VC/Tools/MSVC/14.51.36231/include"
    - "-imsvc/home/guestd/msvc-wine/visualstudio-download/VC/Tools/MSVC/14.51.36231/atlmfc/include"
    - "-imsvc/home/guestd/msvc-wine/visualstudio-download/Windows Kits/10/Include/10.0.26100.0/ucrt"
    - "-imsvc/home/guestd/msvc-wine/visualstudio-download/Windows Kits/10/Include/10.0.26100.0/shared"
    - "-imsvc/home/guestd/msvc-wine/visualstudio-download/Windows Kits/10/Include/10.0.26100.0/um"
    - "-imsvc/home/guestd/msvc-wine/visualstudio-download/Windows Kits/10/Include/10.0.26100.0/winrt"
    - "-I/home/guestd/Project-Reboot-3.0/vendor"
    # the sources include <imgui/...> but the folder is vendor/ImGui (Windows does not care about case); this symlink dir covers it
    - "-I/home/guestd/.cache/reboot-clangd"
    - "-DNDEBUG"
    - "-D_WINDOWS"
    - "-D_USRDLL"
    - "-DPROJECTREBOOT30_EXPORTS"
    - "-DUNICODE"
    - "-D_UNICODE"
    - "-DWIN32"

Diagnostics:
  # system headers are not ours; keep the noise down
  Suppress: [pp_file_not_found_angled_include_not_found]
